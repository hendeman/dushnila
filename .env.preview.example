# Техническое HTTP-превью Hostland. Скопируйте как .env и задайте секреты.
DJANGO_ENVIRONMENT=preview
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=host1889656.hostland.pro
DJANGO_ADMIN_PATH=admin
DJANGO_PUBLIC_SITE_ORIGIN=https://odium.by
DJANGO_CSRF_TRUSTED_ORIGINS=http://host1889656.hostland.pro
DJANGO_ENABLE_DJANGO_EXTENSIONS=False
DJANGO_ENABLE_DEBUG_TOOLBAR=False
DJANGO_STATIC_ROOT=/home/host1889656/host1889656.hostland.pro/projects/odium/public/static
DJANGO_MEDIA_ROOT=/home/host1889656/host1889656.hostland.pro/projects/odium/public/media

# У технического домена нет HTTPS; production позднее включит редирект.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_TRUST_X_FORWARDED_PROTO=False

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY_URL=
TELEGRAM_CONNECT_TIMEOUT=3
TELEGRAM_READ_TIMEOUT=5
