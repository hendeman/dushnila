# Production: скопируйте значения в защищённое окружение сервера или закрытый .env.
DJANGO_ENVIRONMENT=production
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=
DJANGO_ADMIN_PATH=admin
DJANGO_PUBLIC_SITE_ORIGIN=https://odium.by
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ENABLE_DJANGO_EXTENSIONS=False
DJANGO_ENABLE_DEBUG_TOOLBAR=False
DJANGO_STATIC_ROOT=
DJANGO_MEDIA_ROOT=

# Оставьте True, если перенаправление HTTP -> HTTPS выполняет Django.
DJANGO_SECURE_SSL_REDIRECT=True
# Включайте только за контролируемым reverse proxy, который перезаписывает этот заголовок.
DJANGO_TRUST_X_FORWARDED_PROTO=False

# Сначала проверьте HTTPS с нулём, затем увеличивайте HSTS постепенно.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY_URL=
TELEGRAM_CONNECT_TIMEOUT=3
TELEGRAM_READ_TIMEOUT=5
