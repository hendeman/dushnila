# Локальная разработка: скопируйте файл как .env. Сам .env не коммитится.
DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_ADMIN_PATH=admin
DJANGO_PUBLIC_SITE_ORIGIN=https://odium.by
DJANGO_ENABLE_DJANGO_EXTENSIONS=True
DJANGO_ENABLE_DEBUG_TOOLBAR=True

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY_URL=
TELEGRAM_CONNECT_TIMEOUT=3
TELEGRAM_READ_TIMEOUT=5

# Fernet-ключи для секретов подключений из admin; первый ключ используется для записи.
# Создание ключа и ротация: docs/sitecontent/lead-processing.md
LEAD_DELIVERY_ENCRYPTION_KEYS=

# Используется только при DJANGO_ENVIRONMENT=production.
LOG_ALERT_ENABLED=False
LOG_ALERT_SMTP_HOST=
LOG_ALERT_SMTP_PORT=
LOG_ALERT_SMTP_USERNAME=
LOG_ALERT_SMTP_PASSWORD=
LOG_ALERT_SMTP_SECURITY=
LOG_ALERT_FROM_EMAIL=
LOG_ALERT_TO_EMAILS=
LOG_ALERT_SMTP_TIMEOUT=5
LOG_ALERT_COOLDOWN_SECONDS=600
LOG_ALERT_MAX_PER_HOUR=20
